    <main class="main-wrap">
       

        <section class="content-main">

            <form method="post" action="/admin/create-banner" enctype="multipart/form-data" id="createBannerForm">
                <div class="row">
                  <div class="col-6">
                    <div class="content-header">
                      <h2 class="content-title">Create Banner</h2>
                      <div>
                        <button type="button" class="btn btn-md rounded font-sm hover-up"  onclick="validateAndSubmit()">Create</button>
                      </div>
                    </div>
                  </div>
                </div>
              
                <% if (typeof message !== 'undefined') { %>
                  <h3 style="color: rgb(255, 0, 0); font-family: Arial, Helvetica, sans-serif; font-size: small;">
                    <%= message %>
                  </h3>
                <% } %>
              
                <div class="row">
                  <div class="col-lg-6">
                    <div class="card mb-4">
                      <div class="card-body">
                        <div class="row">
                          <div class="col-md-3">
                            <h6>1. General Info</h6>
                          </div>
                          <div class="col-md-9">
                            <div class="mb-4">
                              <label class="form-label">Banner Title</label>
                              <input type="text" name="title" id="title" placeholder="Type Banner Title here" class="form-control" required>
                              <small id="error-title" class="text-danger"></small>
                            </div>
                            <div class="mb-4">
                              <label class="form-label">Banner Image</label>
                              <input type="file" name="images" id="images" class="form-control" required>
                              <small id="error-images" class="text-danger"></small>
                            </div>
                            <div class="mb-4">
                              <label class="form-label">Link</label>
                              <input type="text" name="link" id="link" placeholder="Type Link here" class="form-control" required>
                              <small id="error-link" class="text-danger"></small>
                            </div>
                            <div class="mb-4">
                              <label class="form-label">Associated Offer (Optional)</label>
                              <select name="offer" id="offer" class="form-control">
                                <option value="">None</option>
                                <% offers.forEach(offer => { %>
                                  <option value="<%= offer._id %>"><%= offer.title %></option>
                                <% }); %>
                              </select>
                            </div>
                            <div class="mb-4">
                              <label class="form-label">Status</label>
                              <div class="form-check">
                                <input type="checkbox" name="isActive" id="isActive" class="form-check-input" checked>
                                <label class="form-check-label">Active</label>
                              </div>
                            </div>
                          </div>
                        </div>
                        <hr class="mb-4 mt-0">
                      </div>
                    </div>
                  </div>
                </div>
              </form>
              
        
      
            <div class="container">
                <h2>Banner List</h2>
                <% if (banners.length > 0) { %>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Image</th>
                                <th>Link</th>
                                <th>Offer</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% banners.forEach(function(banner) { %>
                                <tr>
                                    <td><%= banner.title %></td>
                                    <td><img src="<%= banner.images %>" alt="<%= banner.title %>" style="width: 100px;"></td>
                                    <td><a href="<%= banner.link %>" target="_blank">Link</a></td>
                                    <td>
                                        <% if (banner.offer) { %>
                                            <%= banner.offer.title %> - <%= banner.offer.description %>
                                        <% } else { %>
                                            No Offer
                                        <% } %>
                                    </td>
                                    <td><%= banner.isActive ? 'Active' : 'Inactive' %></td>
                                    <td>
                                        <a href="/admin/update-banner/<%= banner._id %>">Edit</a>
                                        <a href="/admin/delete-banner/<%= banner._id %>" onclick="return confirm('Are you sure?')">Delete</a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>

                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                          <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                              <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                            </li>
                          <% } %>
                        </ul>
                      </nav>

                <% } else { %>
                    <p>No banners available</p>
                <% } %>
            </div>
        </section>
        
    
        <footer class="main-footer font-xs">
            <div class="row pb-30 pt-15">
                <div class="col-sm-6">
                    <script>
                    document.write(new Date().getFullYear())
                    </script> ©, TIME - Ecommerce.
                </div>
                <div class="col-sm-6">
                    <div class="text-sm-end">
                        All rights reserved
                    </div>
                </div>
            </div>
        </footer>
    </main>

<script>
    function validateAndSubmit() {
  const form = document.getElementById('createBannerForm');
  let isValid = true;
  const errorMessages = {};

  // Clear previous error messages
  document.querySelectorAll('.text-danger').forEach(error => error.innerHTML = '');

  // Get form values
  const title = document.getElementById('title').value.trim();
  const images = document.getElementById('images').files[0];
  const link = document.getElementById('link').value.trim();

  // Validate Title
  if (!title) {
    errorMessages['error-title'] = 'Title is required.';
    isValid = false;
  }

  // Validate Image File
  if (!images) {
    errorMessages['error-images'] = 'Image file is required.';
    isValid = false;
  } else {
    const allowedExtensions = /(\.jpg|\.jpeg|\.png|\.gif|\.avif)$/i;
    if (!allowedExtensions.exec(images.name)) {
      errorMessages['error-images'] = 'Invalid image format. Allowed: .jpg, .jpeg, .png, .gif, .avif';
      isValid = false;
    }
  }

  // Validate Link
  if (!link) {
    errorMessages['error-link'] = 'Link is required.';
    isValid = false;
  }

  // Display error messages
  Object.keys(errorMessages).forEach(key => {
    document.getElementById(key).innerText = errorMessages[key];
  });

  // Submit form if valid
  if (isValid) {
    form.submit(); // Programmatically submit the form
  }
}

  </script>
