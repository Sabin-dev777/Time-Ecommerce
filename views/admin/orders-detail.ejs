<!DOCTYPE HTML>
<html lang="en">


<!-- Mirrored from wp.alithemes.com/html/evara/evara-backend/page-orders-detail.html by HTTrack Website Copier/3.x [XR&CO'2014], Sun, 01 Aug 2021 15:33:22 GMT -->
<head>
    <meta charset="utf-8">
    <title>Evara Dashboard</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta property="og:title" content="">
    <meta property="og:type" content="">
    <meta property="og:url" content="">
    <meta property="og:image" content="">
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="/admin-assets/imgs/theme/favicon.svg">
    <!-- Template CSS -->
    <link href="/admin-assets/css/main.css" rel="stylesheet" type="text/css" />
</head>

<body>
    <div class="screen-overlay"></div>
    <%- include('../partials/admin/navbar') %>
    <main class="main-wrap">
     
        <section class="content-main">
            <div class="content-header mb-4">
                <div>
                    <h2 class="content-title card-title">Order Details</h2>
                    <p class="text-muted">Details for Order ID: <b><%= order.orderId %></b></p>
                </div>
                <div class="header-actions">
                    <% if (order.orderStatus !== 'cancelled' && order.orderStatus !== 'returned') { %>
                        <button class="btn btn-primary me-2" onclick="handleChangeStatus()">Save Status</button>
                    <% } %>
                    <a class="btn btn-secondary print" href="#"><i class="material-icons md-print"></i> Print</a>
                </div>
            </div>
        
            <div class="card">
                <header class="card-header bg-light p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span>
                                <i class="material-icons md-calendar_today"></i> 
                                <b><%= order.dateOrdered.toISOString().split('T')[0] %></b>
                            </span><br>
                            <small class="text-muted">Order ID: <%= order.orderId %></small>
                        </div>
                        <div>
                            <select id="orderStatusSelect" class="form-select mw-200">
                                <% if (order.orderStatus === 'Order placed') { %>
                                    <option value="Order placed" selected>Order placed</option>
                                    <option value="shipped">Shipped</option>
                                    <option value="delivered">Delivered</option>
                                    <option value="cancelled">Cancelled</option>
                                <% } else if (order.orderStatus === 'shipped') { %>
                                    <option value="shipped" selected>Shipped</option>
                                    <option value="delivered">Delivered</option>
                                    <option value="cancelled" disabled>Cancelled</option>
                                <% } else if (order.orderStatus === 'delivered') { %>
                                    <option value="delivered" selected>Delivered</option>
                                    <option value="returned">Returned</option>
                                <% } else if (order.orderStatus === 'returned') { %>
                                    <option value="returned" selected>Returned</option>
                                <% } else if (order.orderStatus === 'cancelled') { %>
                                    <option value="cancelled" selected>Cancelled</option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                </header>
        
                <div class="card-body">
                    <!-- Section: Customer & Shipping Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <article class="icontext">
                                <span class="icon bg-primary-light rounded-circle">
                                    <i class="material-icons text-primary md-person"></i>
                                </span>
                                <div class="text">
                                    <h6>Customer</h6>
                                    <p>
                                        <b><%= order.user.firstname %> <%= order.user.lastname %></b><br>
                                        Mobile: <%= order.user.mobile %><br>
                                        <a href="#">View profile</a>
                                    </p>
                                </div>
                            </article>
                        </div>
                        <div class="col-md-6">
                            <article class="icontext">
                                <span class="icon bg-primary-light rounded-circle">
                                    <i class="material-icons text-primary md-place"></i>
                                </span>
                                <div class="text">
                                    <h6>Shipping Address</h6>
                                    <% if (order.shippingAddress) { %>
                                        <p>
                                            <b>House:</b> <%= order.shippingAddress.house %><br>
                                            <b>Street:</b> <%= order.shippingAddress.street %><br>
                                            <b>City:</b> <%= order.shippingAddress.city %><br>
                                            <b>Landmark:</b> <%= order.shippingAddress.landmark %><br>
                                            <b>State:</b> <%= order.shippingAddress.state %>, 
                                            <b>Country:</b> <%= order.shippingAddress.country %><br>
                                            <b>ZIP:</b> <%= order.shippingAddress.zip %>
                                        </p>
                                    <% } else { %>
                                        <p class="text-muted">Shipping address not available.</p>
                                    <% } %>
                                </div>
                            </article>
                        </div>
                    </div>
        
                    <!-- Section: Product Details -->
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Unit Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% order.cartItems.forEach(cartItem => { %>
                                    <% cartItem.items.forEach(item => { %>
                                        <tr>
                                            <td>
                                                <a class="itemside" href="#">
                                                    <div class="left">
                                                        <img src="<%='/uploads/' + item.product.images[0] %>" width="50" height="50" class="img-fluid" alt="Item">
                                                    </div>
                                                    <div class="info"><%= item.product.name %></div>
                                                </a>
                                            </td>
                                            <td>$<%= item.product.price.toFixed(2) %></td>
                                            <td><%= item.quantity %></td>
                                            <td>$<%= (item.product.price * item.quantity).toFixed(2) %></td>
                                        </tr>
                                    <% }); %>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
        
                    <!-- Section: Order Summary -->
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Return Request Status</h6>
                            <% if (order.returnRequest.isRequested) { %>
                                <p>
                                    <b>Status:</b>
                                    <span class="badge 
                                        <%= order.returnRequest.status === 'approved' ? 'bg-success text-white' : 
                                            order.returnRequest.status === 'declined' ? 'bg-danger text-white' : 
                                            'bg-warning text-dark' %>">
                                        <%= order.returnRequest.status %>
                                    </span>
                                </p>
                                <% if (order.returnRequest.status === 'requested') { %>
                                    <button class="btn btn-success me-2" onclick="updateReturnRequest('<%= order._id %>', 'approve')">Approve</button>
                                    <button class="btn btn-danger" onclick="updateReturnRequest('<%= order._id %>', 'decline')">Decline</button>
                                <% } %>
                            <% } else { %>
                                <p>No return request made for this order.</p>
                            <% } %>
                        </div>
                        <div class="col-md-6">
                            <h6>Order Summary</h6>
                            <p><b>Subtotal:</b> $<%= order.totalprice.toFixed(2) %></p>
                            <p><b>Shipping:</b> $10.00</p>
                            <h5><b>Grand Total:</b> $<%= (order.totalprice + 10).toFixed(2) %></h5>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <script>
            function updateReturnRequest(orderId, action) {
  fetch(`/admin/orders/${orderId}/return-request`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ action }),
  })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert(data.message);
        location.reload(); // Reload the page to reflect changes
      } else {
        alert(data.message || 'An error occurred');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('An error occurred while processing the return request.');
    });
}

        </script>
        <script>
            function handleChangeStatus() {
                const orderId = '<%= order.orderId %>'; // Replace with the actual order ID
                const newStatus = document.getElementById('orderStatusSelect').value;
                changeOrderStatus(orderId, newStatus);
            }
        </script>
        <script>
            async function changeOrderStatus(orderId, newStatus) {
                try {
                    // Make an AJAX request to the server to update the order status
                    const response = await fetch('/admin/changeOrderStatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ orderId, newStatus }),
                    });
        
                    const data = await response.json();
        
                    // Display an alert with the result
                    alert(data.message);
        
                    // Optionally, you can update the page or perform other actions based on the result
                    if (data.success) {
                        // Update the order status in the UI
                        const statusElement = document.querySelector('.order-status');
                        if (statusElement) {
                            statusElement.innerHTML = `<span class="badge rounded-pill alert-${data.statusColor}">${newStatus}</span>`;
                        }
                    }
                } catch (error) {
                    console.error('Error during order status change:', error);
                    alert('An error occurred during order status change. Please try again.');
                }
            }
        </script> <!-- content-main end// -->
        <footer class="main-footer font-xs">
            <div class="row pb-30 pt-15">
                <div class="col-sm-6">
                    <script data-cfasync="false" src="../../../cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
                    document.write(new Date().getFullYear())
                    </script> ©, Evara - HTML Ecommerce Template .
                </div>
                <div class="col-sm-6">
                    <div class="text-sm-end">
                        All rights reserved
                    </div>
                </div>
            </div>
        </footer>
    </main>
    <script src="/admin-assets/js/vendors/jquery-3.6.0.min.js"></script>
    <script src="/admin-assets/js/vendors/bootstrap.bundle.min.js"></script>
    <script src="/admin-assets/js/vendors/select2.min.js"></script>
    <script src="/admin-assets/js/vendors/perfect-scrollbar.js"></script>
    <script src="/admin-assets/js/vendors/jquery.fullscreen.min.js"></script>
    <!-- Main Script -->
    <script src="/admin-assets/js/main.js" type="text/javascript"></script>
</body>


