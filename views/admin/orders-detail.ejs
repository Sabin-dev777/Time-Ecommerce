        <section class="content-main">
            <div class="content-header">
                <div>
                    <h2 class="content-title card-title">Order detail</h2>
                    <p>Details for Order ID: 3453012</p>
                </div>
            </div>
            <div class="card">
                <header class="card-header">
                    <div class="row align-items-center">
                        <div class="col-lg-6 col-md-6 mb-lg-0 mb-15">
                            <span>
                                <i class="material-icons md-calendar_today"></i> <b><%= order.dateOrdered.toISOString().split('T')[0] %></b>
                            </span> <br>
                            <small class="text-muted">Order ID: <%=order.orderId%></small>
                        </div>
                        <div class="mt-4">
                            <h5>Return Request Status</h5>
                            <% if (order.returnRequest.isRequested) { %>
                              <p>Status: <span class="badge 
                                  <%= order.returnRequest.status === 'approved' ? 'alert-success text-success' : 
                                      order.returnRequest.status === 'declined' ? 'alert-danger text-danger' : 
                                      'alert-warning text-warning' %>">
                                  <%= order.returnRequest.status %>
                                </span>
                              </p>
                            <% } else { %>
                              <p>No return request made for this order.</p>
                            <% } %>
                          
                            <% if (order.returnRequest.isRequested && order.returnRequest.status === 'requested') { %>
                              <button class="btn btn-success" onclick="updateReturnRequest('<%= order._id %>', 'approve')">Approve</button>
                              <button class="btn btn-danger" onclick="updateReturnRequest('<%= order._id %>', 'decline')">Decline</button>
                            <% } %>
                          </div>
                          
                          <div class="col-lg-6 col-md-6 ms-auto text-md-end">
                            <select id="orderStatusSelect" class="form-select d-inline-block mb-lg-0 mb-15 mw-200">
                                <% if (order.orderStatus === 'Order placed') { %>
                                    <option value="Order placed" selected>Order placed</option>
                                    <option value="shipped">Shipped</option>
                                    <option value="delivered">Delivered</option>
                                    <option value="cancelled">Cancelled</option>
                                <% } else if (order.orderStatus === 'shipped') { %>
                                    <option value="shipped" selected>Shipped</option>
                                    <option value="delivered">Delivered</option>
                                    <option value="cancelled" disabled>Cancelled</option>
                                <% } else if (order.orderStatus === 'delivered') { %>
                                    <option value="delivered" selected>Delivered</option>
                                    <option value="returned">Returned</option>
                                <% } else if (order.orderStatus === 'returned') { %>
                                    <option value="returned" selected>Returned</option>
                                <% } else if (order.orderStatus === 'cancelled') { %>
                                    <option value="cancelled" selected>Cancelled</option>
                                <% } %>
                            </select>
                        
                            <!-- Button to trigger the status change -->
                            <% if (order.orderStatus !== 'cancelled' && order.orderStatus !== 'returned') { %>
                                <button class="btn btn-primary" onclick="handleChangeStatus()">Save</button>
                            <% } %>
                            <a class="btn btn-secondary print ms-2" href="#"><i class="icon material-icons md-print"></i></a>
                        </div>
                        
