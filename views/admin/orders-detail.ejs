        <script>
            function updateReturnRequest(orderId, action) {
  fetch(`/admin/orders/${orderId}/return-request`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ action }),
  })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert(data.message);
        location.reload(); // Reload the page to reflect changes
      } else {
        alert(data.message || 'An error occurred');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('An error occurred while processing the return request.');
    });
}

        </script>
        <script>
            function handleChangeStatus() {
                const orderId = '<%= order.orderId %>'; // Replace with the actual order ID
                const newStatus = document.getElementById('orderStatusSelect').value;
                changeOrderStatus(orderId, newStatus);
            }
        </script>
        <script>
            async function changeOrderStatus(orderId, newStatus) {
                try {
                    // Make an AJAX request to the server to update the order status
                    const response = await fetch('/admin/changeOrderStatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ orderId, newStatus }),
                    });
        
                    const data = await response.json();
        
                    // Display an alert with the result
                    alert(data.message);
        
                    // Optionally, you can update the page or perform other actions based on the result
                    if (data.success) {
                        // Update the order status in the UI
                        const statusElement = document.querySelector('.order-status');
                        if (statusElement) {
                            statusElement.innerHTML = `<span class="badge rounded-pill alert-${data.statusColor}">${newStatus}</span>`;
                        }
                    }
                } catch (error) {
                    console.error('Error during order status change:', error);
                    alert('An error occurred during order status change. Please try again.');
                }
            }
        </script> <!-- content-main end// -->
