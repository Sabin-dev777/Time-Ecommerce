    <main class="main-wrap">
        
        <section class="content-main">
          <form id="couponForm" action="/admin/create-coupon" method="post">
            <div id="error-messages" style="color:red;"></div> <!-- General error messages container -->
            
            <div class="row">
              <div class="col-6">
                <div class="content-header">
                  <h2 class="content-title">Create Coupon</h2>
                  <div>
                    <button type="button" class="btn btn-md rounded font-sm hover-up" onclick="validateAndSubmit()">Create</button>
                  </div>
                </div>
              </div>
            </div>
          
            <!-- Coupon Details -->
            <div class="row">
              <div class="col-lg-6">
                <div class="card mb-4">
                  <div class="card-body">
                    <div class="row">
                      <div class="col-md-3">
                        <h6>1. Coupon Details</h6>
                      </div>
                      <div class="col-md-9">
                        <!-- Coupon Code -->
                        <div class="mb-4">
                          <label class="form-label">Coupon Code</label>
                          <input type="text" id="couponCode" name="couponCode" placeholder="Enter Coupon Code" class="form-control">
                          <div id="error-couponCode" class="error-message" style="color:red;"></div>
                        </div>
          
                        <!-- Discount -->
                        <div class="mb-4">
                          <label class="form-label">Discount (%)</label>
                          <input type="number" id="discount" name="discount" placeholder="Enter Discount %" class="form-control" min="0" max="99">
                          <div id="error-discount" class="error-message" style="color:red;"></div>
                        </div>
          
                        <!-- Validity Date -->
                        <div class="mb-4">
                          <label class="form-label">Valid Until</label>
                          <input type="date" id="validUntil" name="validUntil" class="form-control">
                          <div id="error-validUntil" class="error-message" style="color:red;"></div>
                        </div>
          
                        <!-- Minimum Purchase Amount -->
                        <div class="mb-4">
                          <label class="form-label">Minimum Purchase Amount (INR)</label>
                          <input type="number" id="minPurchaseAmount" name="minPurchaseAmount" placeholder="Enter minimum purchase amount" class="form-control">
                          <div id="error-minPurchaseAmount" class="error-message" style="color:red;"></div>
                        </div>
          
                        <!-- Maximum Discount -->
                        <div class="mb-4">
                          <label class="form-label">Maximum Discount (INR)</label>
                          <input type="number" id="maxDiscount" name="maxDiscount" placeholder="Enter maximum discount amount" class="form-control">
                          <div id="error-maxDiscount" class="error-message" style="color:red;"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </form>
              <div class="container">
                <h2>Coupon List</h2>
                <% if (coupons && coupons.length > 0) { %>
                  <table class="table">
                    <thead>
                      <tr>
                        <th>Coupon Code</th>
                        <th>Discount (%)</th>
                        <th>Valid Until</th>
                        <th>Status</th>

                        <!-- <th>Usage Count</th>
                        <th>Max Usage Per User</th>
                        <th>Usage Limit</th> -->

                        <th>Min Purchase Amount (INR)</th>
                        <th>Max Discount (INR)</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% coupons.forEach(coupon => { %>
                        <tr>
                          <td><%= coupon.couponCode %></td>
                          <td><%= coupon.discount %></td>
                          <td><%= coupon.validUntil.toLocaleDateString() %></td>
                          <td><%= coupon.status ? 'Active' : 'Inactive' %></td>

                          <!-- <td><%= coupon.usageCount %></td>
                          <td><%= coupon.maxUsagePerUser %></td>
                          <td><%= coupon.usageLimit %></td> -->

                          <td><%= coupon.minPurchaseAmount || 'N/A' %></td>
                          <td><%= coupon.maxDiscount || 'N/A' %></td>
                          <td>
                            <a href="/admin/edit-coupon/<%= coupon._id %>" class="btn btn-sm btn-primary">Edit</a>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                <% } else { %>
                  <p>No coupons available</p>
                <% } %>
              </div>
              <div class="pagination-area mt-30 mb-50">
                <nav aria-label="Page navigation example">
                  <ul class="pagination justify-content-start">
                    <% if (currentPage > 1) { %>
                      <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage - 1 %>">&laquo;</a>
                      </li>
                    <% } %>
              
                    <% for (let i = 1; i <= totalPages; i++) { %>
                      <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                      </li>
                    <% } %>
              
                    <% if (currentPage < totalPages) { %>
                      <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage + 1 %>">&raquo;</a>
                      </li>
                    <% } %>
                  </ul>
                </nav>
              </div>
              
              
              
        </section> <!-- content-main end// -->
        <footer class="main-footer font-xs">
            <div class="row pb-30 pt-15">
                <div class="col-sm-6">
                    <script>
                    document.write(new Date().getFullYear())
                    </script> ©, TIME - Ecommerce .
                </div>
                <div class="col-sm-6">
                    <div class="text-sm-end">
                        All rights reserved
                    </div>
                </div>
            </div>
        </footer>
    </main>
    <script>
      function validateAndSubmit() {
        // Clear previous error messages
        document.querySelectorAll('.error-message').forEach(el => el.innerText = '');
    
        let isValid = true;
    
        // Coupon Code Validation
        const couponCode = document.getElementById('couponCode').value;
        if (!couponCode) {
          document.getElementById('error-couponCode').innerText = 'Coupon code is required';
          isValid = false;
        }
    
        // Discount Validation
        const discount = document.getElementById('discount').value;
        if (!discount || discount <= 0 || discount >= 100) {
          document.getElementById('error-discount').innerText = 'Discount must be between 1 and 99%';
          isValid = false;
        }
    
        // Validity Date Validation
        const validUntil = document.getElementById('validUntil').value;
        if (!validUntil || new Date(validUntil) < new Date()) {
          document.getElementById('error-validUntil').innerText = 'Enter a valid date in the future';
          isValid = false;
        }
    
        // Minimum Purchase Amount Validation
        const minPurchaseAmount = document.getElementById('minPurchaseAmount').value;
        if (minPurchaseAmount < 0) {
          document.getElementById('error-minPurchaseAmount').innerText = 'Minimum purchase amount cannot be negative';
          isValid = false;
        }
    
        // Maximum Discount Validation
        const maxDiscount = document.getElementById('maxDiscount').value;
        if (maxDiscount && maxDiscount <= 0) {
          document.getElementById('error-maxDiscount').innerText = 'Maximum discount must be greater than 0';
          isValid = false;
        }
    
        // Submit the form if all fields are valid
        if (isValid) {
          document.getElementById('couponForm').submit();
        }
      }
    </script>
