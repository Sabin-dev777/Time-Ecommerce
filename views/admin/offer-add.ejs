    <main class="main-wrap">
   

        <section class="content-main">
          <form  method="post" action="/admin/create-offer">
            <div class="row">
              <div class="col-6">
                <div class="content-header">
                  <h2 class="content-title">Create Offer</h2>
                  <div>
                    <button type="submit" class="btn btn-md rounded font-sm hover-up">Create</button>
                  </div>
                </div>
              </div>
            </div>
          
            <div class="row">
              <div class="col-lg-6">
                <div class="card mb-4">
                  <div class="card-body">
                    <div class="row">
                      <div class="col-md-3">
                        <h6>1. General Info</h6>
                      </div>
                      <div class="col-md-9">
                        <!-- Offer Title Field -->
                        <div class="mb-4">
                          <label class="form-label">Offer Title</label>
                          <input type="text" name="title" placeholder="Type Offer Title here" class="form-control" value="<%= formData.title || '' %>">
                          <% if (errors && errors.title) { %>
                            <div class="error-message" style="color: red;"><%= errors.title %></div>
                          <% } %>
                        </div>
          
                        <!-- Description Field -->
                        <div class="mb-4">
                          <label class="form-label">Description</label>
                          <textarea name="description" placeholder="Type Offer Description here" class="form-control" rows="4"><%= formData.description || '' %></textarea>
                          <% if (errors && errors.description) { %>
                            <div class="error-message" style="color: red;"><%= errors.description %></div>
                          <% } %>
                        </div>
          
                        <!-- Offer Type Field -->
                        <div class="mb-4">
                          <label class="form-label">Offer Type</label>
                          <select name="type" class="form-control">
                            <option value="percentage" <%= formData.type === 'percentage' ? 'selected' : '' %>>Percentage</option>
                            <option value="fixed" <%= formData.type === 'fixed' ? 'selected' : '' %>>Fixed</option>
                            <option value="bogo" <%= formData.type === 'bogo' ? 'selected' : '' %>>Buy-One-Get-One</option>
                          </select>
                          <% if (errors && errors.type) { %>
                            <div class="error-message" style="color: red;"><%= errors.type %></div>
                          <% } %>
                        </div>
          
                        <!-- Offer Value Field -->
                        <div class="mb-4">
                          <label class="form-label">Offer Value</label>
                          <input type="number" name="value" placeholder="Type Offer Value here" class="form-control" step="0.01" value="<%= formData.value || '' %>">
                          <% if (errors && errors.value) { %>
                            <div class="error-message" style="color: red;"><%= errors.value %></div>
                          <% } %>
                        </div>
          
                        <!-- Start Date Field -->
                        <div class="mb-4">
                          <label class="form-label">Start Date</label>
                          <input type="date" name="startDate" class="form-control" value="<%= formData.startDate ? new Date(formData.startDate).toISOString().split('T')[0] : '' %>">
                          <% if (errors && errors.startDate) { %>
                            <div class="error-message" style="color: red;"><%= errors.startDate %></div>
                          <% } %>
                        </div>
          
                        <!-- End Date Field -->
                        <div class="mb-4">
                          <label class="form-label">End Date</label>
                          <input type="date" name="endDate" class="form-control" value="<%= formData.endDate ? new Date(formData.endDate).toISOString().split('T')[0] : '' %>">
                          <% if (errors && errors.endDate) { %>
                            <div class="error-message" style="color: red;"><%= errors.endDate %></div>
                          <% } %>
                        </div>
          
                        <!-- Status Field -->
                        <div class="mb-4">
                          <label class="form-label">Status</label>
                          <div class="form-check">
                            <input type="checkbox" name="isActive" class="form-check-input" <%= formData.isActive ? 'checked' : '' %>>
                            <label class="form-check-label">Active</label>
                          </div>
                          <% if (errors && errors.isActive) { %>
                            <div class="error-message" style="color: red;"><%= errors.isActive %></div>
                          <% } %>
                        </div>
                      </div>
                    </div>
                    <hr class="mb-4 mt-0">
                  </div>
                </div>
              </div>
            </div>
          </form>
          
              <div class="container">
                <h2>Offer List</h2>
                <% if (offers.length > 0) { %>
                  <table class="table">
                    <thead>
                      <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Value</th>
                        <th>Category</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% offers.forEach(function(offer) { %>
                        <tr>
                          <td><%= offer.title %></td>
                          <td><%= offer.description %></td>
                          <td><%= offer.type %></td>
                          <td><%= offer.value %></td>
                          <td><%= offer.category ? offer.category.name : 'No Category' %></td>
                          <td><%= new Date(offer.startDate).toLocaleDateString() %></td>
                          <td><%= new Date(offer.endDate).toLocaleDateString() %></td>
                          <td><%= offer.isActive ? 'Active' : 'Inactive' %></td>
                          <td>
                            <div class="d-flex gap-2 align-items-center">
                              <!-- Edit Button -->
                              <a href="/admin/edit-offer/<%= offer._id %>" class="btn btn-primary btn-sm action-button">
                                Edit
                              </a>
                              <!-- Delete Button with confirmation dialog -->
                              <form action="/admin/delete-offer/<%= offer._id %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm action-button" onclick="return confirm('Are you sure you want to delete this offer?')">
                                  Delete
                                </button>
                              </form>
                            </div>
                          </td>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                <% } else { %>
                  <p>No offers available</p>
                <% } %>
              </div>

              <div class="pagination-area mt-30 mb-50">
                <nav aria-label="Page navigation example">
                  <ul class="pagination justify-content-start">
                    <% if (currentPage > 1) { %>
                      <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage - 1 %>">&laquo;</a>
                      </li>
                    <% } %>
              
                    <% for (let i = 1; i <= totalPages; i++) { %>
                      <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                      </li>
                    <% } %>
              
                    <% if (currentPage < totalPages) { %>
                      <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage + 1 %>">&raquo;</a>
                      </li>
                    <% } %>
                  </ul>
                </nav>
              </div>
              
        </section> <!-- content-main end// -->
        
    
