        <script>
          document.getElementById('offerForm').addEventListener('submit', function (e) {
            e.preventDefault(); // Prevent form submission for validation check
        
            // Clear any previous error messages
            document.querySelectorAll('.error').forEach(el => el.remove());
        
            let isValid = true;
        
            // Validation logic
            const title = document.querySelector('[name="title"]');
            if (!title.value.trim()) {
              displayError(title, 'Offer title is required');
              isValid = false;
            }
        
            const description = document.querySelector('[name="description"]');
            if (!description.value.trim()) {
              displayError(description, 'Description is required');
              isValid = false;
            }
        
            const type = document.querySelector('[name="type"]');
            if (!type.value) {
              displayError(type, 'Please select an offer type');
              isValid = false;
            }
        
            const value = document.querySelector('[name="value"]');
            const offerType = type.value;
            const valueNumber = parseFloat(value.value);
            if (isNaN(valueNumber) || valueNumber <= 0 || (offerType === 'percentage' && valueNumber >= 100)) {
              displayError(value, 'Please enter a valid offer value (non-negative, < 100 if percentage)');
              isValid = false;
            }
        
            const startDate = document.querySelector('[name="startDate"]');
            const endDate = document.querySelector('[name="endDate"]');
            if (!startDate.value) {
              displayError(startDate, 'Start date is required');
              isValid = false;
            }
            if (!endDate.value) {
              displayError(endDate, 'End date is required');
              isValid = false;
            } else if (new Date(startDate.value) > new Date(endDate.value)) {
              displayError(endDate, 'End date must be after start date');
              isValid = false;
            }
        
            // If all validations pass, submit the form
            if (isValid) {
              this.submit();
            }
          });
        
          // Function to display error messages
          function displayError(element, message) {
            const error = document.createElement('div');
            error.className = 'error text-danger';
            error.innerText = message;
            element.parentNode.appendChild(error);
          }
        </script>
        
    </main>
