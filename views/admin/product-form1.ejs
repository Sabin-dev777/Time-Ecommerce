<body>
    <div class="screen-overlay"></div>
    <%- include('../partials/admin/navbar') %>
    <main class="main-wrap">
        
        <section class="content-main">

            <form id="productForm" action="/admin/add-product" method="post" enctype="multipart/form-data">
                <div id="error-messages" style="color:red;"></div> <!-- Error messages container -->
                <div class="row">
                    <div class="col-6">
                        <div class="content-header">
                            <h2 class="content-title">Add New Product</h2>
                            <div>
                                <button type="button" class="btn btn-md rounded font-sm hover-up" onclick="validateAndSubmit()">Add</button>
                            </div>
                        </div>
                    </div>
                </div>
            
                <!-- General Info -->
                <div class="row">
                    <div class="col-lg-6">
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-3">
                                        <h6>1. General info</h6>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="mb-4">
                                            <label class="form-label">Product Name</label>
                                            <input type="text" id="name" name="name" placeholder="Type here" class="form-control">
                                            <div id="error-name" class="error-message" style="color:red;"></div>
                                        </div>
                                        <div class="mb-4">
                                            <label class="form-label">Description</label>
                                            <textarea id="description" name="description" placeholder="Type here" class="form-control" rows="4"></textarea>
                                            <div id="error-description" class="error-message" style="color:red;"></div>
                                        </div>
                                        <div class="mb-4">
                                            <label class="form-label">Rich Description</label>
                                            <textarea id="richDescription" name="richDescription" placeholder="Type here" class="form-control" rows="4"></textarea>
                                        </div>
                                        <div class="mb-4">
                                            <label for="brand" class="form-label">Brand:</label>
                                            <select id="brand" name="brand" class="form-control" required>
                                                <% brands.forEach(brand => { %>
                                                    <option value="<%= brand._id %>"><%= brand.brandname %></option>
                                                <% }) %>
                                            </select>
                                            <div id="error-brand" class="error-message" style="color:red;"></div>
                                        </div>
                                        <div class="mb-4">
                                            <label for="gender" class="form-label">Gender:</label>
                                            <select id="gender" name="gender" class="form-control" required>
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                                <option value="Unisex">Unisex</option>
                                            </select>
                                            <div id="error-gender" class="error-message" style="color:red;"></div>
                                        </div>
                                    </div>
                                </div>
            
                                <!-- Pricing -->
                                <hr class="mb-4 mt-0">
                                <div class="row">
                                    <div class="col-md-3">
                                        <h6>2. Pricing</h6>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="mb-4">
                                            <label class="form-label">Cost in INR</label>
                                            <input id="price" name="price" type="text" placeholder="₹00.0" class="form-control">
                                            <div id="error-price" class="error-message" style="color:red;"></div>
                                        </div>
                                    </div>
                                </div>
            
                                <!-- Sizes and Stock -->
                                <hr class="mb-4 mt-0">
                                <div class="row">
                                    <div class="col-md-3">
                                        <h6>3. Sizes & Stock</h6>
                                    </div>
                                    <div class="col-md-9">
                                        <div id="size-fields">
                                            <!-- Repeated size and quantity fields -->
                                            <% for (let i = 0; i < 4; i++) { %>

                                                <div class="size-entry mb-4">
                                                    <label class="form-label">Size</label>
                                                    <input type="text" id="size-<%= i %>" name="sizes[<%= i %>][size]" placeholder="Enter size" class="form-control">
