                                                <div class="size-entry mb-4">
                                                    <label class="form-label">Quantity</label>
                                                    <input type="number" id="quantity-<%= i %>" min="0" name="sizes[<%= i %>][quantity]" placeholder="Enter quantity" class="form-control" oninput="calculateTotalQuantity()">
                                                    <div id="error-quantity-<%= i %>" class="error-message" style="color:red;"></div>
                                                </div>
                                                
                                                
                                        
                                            <% } %>
                                        </div>
                                        <div class="mb-4">
                                            <label class="form-label">Total Quantity</label>
                                            <input type="number" id="totalQuantity" name="countInStock" class="form-control" readonly>
