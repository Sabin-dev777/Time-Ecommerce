                                                    <option value="<%= category._id %>"><%= category.name %></option>
                                                <% }); %>
                                            </select>
                                            <div id="error-category" class="error-message" style="color:red;"></div>
                                        </div>
                                    </div>
                                </div>
            
                                <!-- Media -->
                                <hr class="mb-4 mt-0">
                                <div class="row">
                                    <div class="col-md-3">
                                        <h6>5. Media</h6>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="mb-4">
                                            <label class="form-label">Images</label>
                                            <input class="form-control" id="images" name="images" type="file" multiple onchange="previewImages(event)">
                                            <div id="error-images" class="error-message" style="color:red;"></div>
                                        </div>
                                        <div id="image-preview" class="row"></div>
                                        <div id="file-info"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
          <!-- Crop Modal -->
<div id="cropModal">
    <div class="modal-content">
      <span id="closeModal" onclick="closeModal()">×</span>
      <h4>Crop Image</h4>
      <div>
        <img id="cropImage" style="width: 100%; max-width: 500px;">
      </div>
      <!-- Custom width and height input fields -->
      <div>
        <label for="customWidth">Width:</label>
        <input type="number" id="customWidth" placeholder="Enter width in px" min="1">
        <label for="customHeight">Height:</label>
        <input type="number" id="customHeight" placeholder="Enter height in px" min="1">
        <button type="button" onclick="setCustomDimensions()">Set Dimensions</button>
      </div>
      <button type="button" onclick="cropCurrentImage()">Crop & Save</button>
    </div>
  </div>
  
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
            
            
            <script>
                function showCropModal(index) {
  const cropModal = document.getElementById('cropModal');
  cropModal.style.display = 'block';
  document.getElementById('cropImage').src = URL.createObjectURL(imageFiles[index]);

  // Initialize or reinitialize cropper
  if (cropper) cropper.destroy();
  cropper = new Cropper(document.getElementById('cropImage'), { aspectRatio: 1 });

  currentFileIndex = index;
}

function closeModal() {
  document.getElementById('cropModal').style.display = 'none';
  if (cropper) cropper.destroy();
}




                let cropper;
let currentFileIndex = 0;
let imageFiles = [];

// Handle file selection
document.getElementById('images').addEventListener('change', (event) => {
  imageFiles = Array.from(event.target.files);
  showCropModal(0); // Start cropping from the first file
});

// Show modal for cropping the current image
function showCropModal(index) {
  currentFileIndex = index;
  if (index >= imageFiles.length) return;

  const file = imageFiles[index];
  const reader = new FileReader();
  reader.onload = () => {
    document.getElementById('cropImage').src = reader.result;
    document.getElementById('cropModal').style.display = 'block';

    // Initialize cropper after image loads
    cropper = new Cropper(document.getElementById('cropImage'), {
      viewMode: 1,
      autoCropArea: 1,
    });
  };
  reader.readAsDataURL(file);
}

// Set custom dimensions based on user input
function setCustomDimensions() {
  const customWidth = parseInt(document.getElementById('customWidth').value);
  const customHeight = parseInt(document.getElementById('customHeight').value);

  if (customWidth > 0 && customHeight > 0 && cropper) {
    cropper.setCropBoxData({
      width: customWidth,
      height: customHeight,
    });
  }
}

// Crop the current image and save it
function cropCurrentImage() {
  if (cropper) {
    const originalFileType = imageFiles[currentFileIndex].type;
    const outputType = originalFileType === 'image/avif' ? 'image/avif' : 'image/jpeg';

    cropper.getCroppedCanvas().toBlob((blob) => {
      imageFiles[currentFileIndex] = new File([blob], imageFiles[currentFileIndex].name, { type: outputType });

      // Move to next image or close modal if done
      cropper.destroy();
      document.getElementById('cropModal').style.display = 'none';
      currentFileIndex++;
      if (currentFileIndex < imageFiles.length) {
        showCropModal(currentFileIndex);
      } else {
        previewCroppedImages(); // Show cropped images in preview
      }
    }, outputType); // Set the type to 'image/avif' if needed
  }
}

// Close the modal
function closeModal() {
  if (cropper) {
    cropper.destroy();
    document.getElementById('cropModal').style.display = 'none';
  }
}

// Preview the cropped images
function previewCroppedImages() {
  const previewContainer = document.getElementById('image-preview');
  previewContainer.innerHTML = '';
  imageFiles.forEach((file, index) => {
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = document.createElement('img');
      img.src = e.target.result;
      img.style.width = '100px';
      img.style.margin = '5px';
      previewContainer.appendChild(img);
    };
    reader.readAsDataURL(file);
  });
}




      function validateAndSubmit() {
        const formData = new FormData(document.getElementById('productForm'));
  imageFiles.forEach((file, index) => {
    formData.append('images[]', file);
  });
  // Track validity of form fields
  let isValid = true;
  const errorMessages = {};

  // Clear previous error messages
  document.querySelectorAll('.error-message').forEach(error => error.innerHTML = '');

  // Validate Product Name
  const name = document.getElementById('name').value.trim();
  if (!name) {
    errorMessages['error-name'] = 'Product Name is required';
    isValid = false;
  }

  // Validate Product Description
  const description = document.getElementById('description').value.trim();
  if (!description) {
    errorMessages['error-description'] = 'Description is required';
    isValid = false;
  }

  // Validate Product Price (ensure it is a positive number)
  const price = document.getElementById('price').value.trim();
  if (!price || isNaN(price) || parseFloat(price) <= 0) {
    errorMessages['error-price'] = 'Enter a valid positive price';
    isValid = false;
  }

  // Validate Product Brand
  const brand = document.getElementById('brand').value.trim();
  if (!brand) {
    errorMessages['error-brand'] = 'Brand is required';
    isValid = false;
  }

  // Validate Sizes & Stock (for each size entry)
  let totalQuantity = 0;
  const sizeFields = document.querySelectorAll('.size-entry input[name$="[quantity]"]'); // Select all quantity fields

  sizeFields.forEach((quantityField, index) => {
    const quantity = parseInt(quantityField.value.trim(), 10);
    
    // Validate quantity for each size entry
    if (isNaN(quantity) || quantity < 0) {
      errorMessages[`error-quantity-${index}`] = 'Quantity must be a non-negative number';
      isValid = false;
    } else {
      totalQuantity += quantity;  // Sum the quantities for total quantity field
    }
  });

  // Update the total quantity field
  if (isValid) {
    document.getElementById('totalQuantity').value = totalQuantity;
  }

  // Validate Image Files
  const imageInput = document.getElementById('images');
  const allowedExtensions = /(\.jpg|\.jpeg|\.png|\.gif|\.avif)$/i; // Allow .avif files
  
  if (imageInput.files.length > 0) {
    for (let i = 0; i < imageInput.files.length; i++) {
      const file = imageInput.files[i];
      if (!allowedExtensions.exec(file.name)) {
        errorMessages['error-images'] = 'Only image files (.jpg, .jpeg, .png, .gif, .avif) are allowed';
        isValid = false;
        break; // Exit loop if an invalid file type is found
      }
    }
  }

  // Display all error messages
  Object.keys(errorMessages).forEach(key => {
    const errorElement = document.getElementById(key);
    if (errorElement) {
      errorElement.innerHTML = errorMessages[key];
    }
  });

  // Submit the form if all validations pass
  if (isValid) {
    document.getElementById('productForm').submit();
  }
}

              </script>
              
              
       
        <script>
        function calculateTotalQuantity() {
    let total = 0;
    const quantityFields = document.querySelectorAll('.size-entry input[name$="[quantity]"]');

    quantityFields.forEach(field => {
      const value = parseInt(field.value.trim(), 10);
      if (!isNaN(value) && value >= 0) {
        total += value;
      }
    });

    document.getElementById('totalQuantity').value = total;
  }
        </script>
            <script>
                let selectedFiles = [];
            
                function previewImages(event) {
                    const files = Array.from(event.target.files);
            
                    // Append new files to the existing selection
                    selectedFiles = [...selectedFiles, ...files];
            
                    // Update previews and file info
                    updatePreviews();
                }
            
                function updatePreviews() {
                    const previewContainer = document.getElementById('image-preview');
                    const fileInfoContainer = document.getElementById('file-info');
                    previewContainer.innerHTML = ''; // Clear existing previews
                    fileInfoContainer.innerHTML = ''; // Clear existing file info
            
                    const fileCount = document.createElement('p');
                    fileCount.textContent = `Number of files chosen: ${selectedFiles.length}`;
                    fileInfoContainer.appendChild(fileCount);
            
                    selectedFiles.forEach((file, index) => {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const container = document.createElement('div');
                            container.style.display = 'inline-block';
                            container.style.position = 'relative';
                            container.style.margin = '10px';
            
                            const imgElement = document.createElement('img');
                            imgElement.src = e.target.result;
                            imgElement.style.maxWidth = '150px';
                            imgElement.style.display = 'block';
                            container.appendChild(imgElement);
            
                            const removeButton = document.createElement('button');
                            removeButton.textContent = 'Remove';
                            removeButton.type = 'button'; // Prevent form submission
                            removeButton.style.position = 'absolute';
                            removeButton.style.top = '0';
                            removeButton.style.right = '0';
                            removeButton.onclick = () => removeFile(index, container);
                            container.appendChild(removeButton);
            
                            previewContainer.appendChild(container);
                        }
                        reader.readAsDataURL(file);
                    });
                }
            
                function removeFile(index, container) {
                    // Remove the file from selectedFiles
                    selectedFiles.splice(index, 1);
            
                    // Remove the container from the DOM
                    container.remove();
            
                    // Update the file input element (create a new DataTransfer object)
                    const fileInput = document.querySelector('input[name="images"]');
                    const dataTransfer = new DataTransfer();
                    selectedFiles.forEach(file => dataTransfer.items.add(file));
                    fileInput.files = dataTransfer.files;
            
                    // Update the file info display
                    updateFileInfo();
                }
            
                function updateFileInfo() {
                    const fileInfoContainer = document.getElementById('file-info');
                    fileInfoContainer.innerHTML = '';
            
                    const fileCount = document.createElement('p');
                    fileCount.textContent = `Number of files chosen: ${selectedFiles.length}`;
                    fileInfoContainer.appendChild(fileCount);
            
                    selectedFiles.forEach((file, index) => {
                        const fileUrl = document.createElement('p');
                        fileUrl.textContent = `File ${index + 1}: ${file.name}`;
                        fileInfoContainer.appendChild(fileUrl);
                    });
                }
            </script>
