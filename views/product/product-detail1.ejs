      <section class="mt-50 mb-50">
        <div class="container">
          <div class="container mt-4">
            <div class="row">
              <!-- Product Image Gallery -->
              <div class="col-md-6">
                <div class="detail-gallery">
                  <div class="product-image-slider">
                    <% if (product.images && product.images.length > 0) { %>
                      <% for (let i = product.images.length - 1; i >= 0; i--) { %>
                        <a href="<%= '/uploads/' + product.images[i] %>" class="MagicZoom">
                          <img src="<%= '/uploads/' + product.images[i] %>" alt="product image">
                        </a>
                      <% } %>
                    <% } %>
                  </div>
                  <!-- THUMBNAILS -->
                  <div class="slider-nav-thumbnails pl-15 pr-15">
                    <% if (product.images && product.images.length > 0) { %>
                      <% for (let i = product.images.length - 1; i >= 0; i--) { %>
                        <div>
                          <img class="thumbnail-img" src="<%= '/uploads/' + product.images[i] %>" alt="product thumbnail">
                        </div>
                      <% } %>
                    <% } else { %>
                      <div>No images available</div>
                    <% } %>
                  </div>
                </div>
              </div>
              
              <!-- Product Details -->
              <div class="col-md-6">
                <div class="detail-info">
                  <h2 class="title-detail"><%= product.name %></h2>
              
                  <!-- Product Rating -->
                  <div class="product-detail-rating">
                    <div class="pro-details-brand">
                      <span>Brands: <a href="shop-grid-right.html"><%= product.brand.brandname %></a></span>
                    </div>
                    <div class="product-rate-cover text-end">
                      <div class="product-rate d-inline-block">
