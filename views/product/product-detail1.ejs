                      </div>
                      <span class="font-small ml-5 text-muted">(25 reviews)</span>
                    </div>
                  </div>
              
                  <!-- Product Price -->
                  <div class="clearfix product-price-cover">
                    <div class="product-price primary-color float-left">
                      <% if (product.discountedPrice) { %>
                        <ins>
                          <span class="text-brand">$<%= product.discountedPrice.toFixed(2) %></span>
                        </ins>
                        <span class="old-price font-md ml-15">$<%= product.price %></span>
                        <span class="save-price font-md color3 ml-15">
                         
                        </span>
                      <% } else { %>
                        <ins>
                          <span class="text-brand">&#8377;<%= product.price %></span>
                        </ins>
                      <% } %>
                    </div>
                  </div>
              
                  <div class="bt-1 border-color-1 mt-15 mb-15"></div>
              
                  <!-- Short Description -->
                  <div class="short-desc mb-30">
                    <p><%= product.richDescription %></p>
                  </div>
              
                  <!-- Sizes and Stock -->
                  <div class="attr-detail attr-size">
                    <strong class="mr-10">Size</strong>
                    <ul class="list-filter size-filter font-small" id="size-list">
                      <% product.sizes.forEach(size => { %>
                        <li data-size="<%= size.size %>" data-quantity="<%= size.quantity %>">
                          <a href="javascript:void(0);" class="size-option">
                            <span class="size-label"><%= size.size %></span>
                            <span class="size-stock">(<%= size.quantity %> in stock)</span>
                          </a>
                        </li>
                      <% }); %>
                    </ul>
                  </div>
              
                  <!-- Add to Cart and Wishlist -->
                  <div class="detail-extralink">
                    <div class="product-extra-link2">
                      <form action="/product/addto-cart" method="post" id="add-to-cart-form" style="display: flex; align-items: center;">
                        <div class="mr-3">
                          <label for="quantity-select" class="mr-2">Quantity:</label>
                          <select id="quantity-select" class="qty-val" name="quantity">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                          </select>
                        </div>
                        <div>
                          <input type="hidden" id="selected-size" name="size" />
                          <input type="hidden" name="productId" value="<%= product._id %>" />
                          <button type="submit" class="button button-add-to-cart" style="height: 40px;">Add to cart</button>
                        </div>
                        <% if(typeof message !== 'undefined') { %>
                          <h3 style="color: rgb(255, 0, 0); font-family: Arial, Helvetica, sans-serif; font-size: small; font-style: normal; font-weight: 400;"><%= message %></h3>
                          <% } %>
                        <div class="ml-3">
                          <button type="button" class="button button-add-to-cart" style="height: 40px;" onclick="window.location.href='/cart';">View cart</button>
                        </div>
                      </form>
                    </div>
                  </div>
              
                  <a aria-label="Add To Wishlist" class="action-btn hover-up" href="javascript:void(0);" onclick="addToWishlist('<%= product._id %>')">
                    <i class="fi-rs-heart"></i>
                  </a>
                  <div id="wishlistModal" class="modal" style="display: none;">
                    <div class="modal-content">
                      <span class="close">&times;</span>
                      <p id="wishlistMessage">Product added to your wishlist!</p>
                    </div>
                  </div>
                </div>
              
                <!-- Product Meta -->
               
              </div>
  

                <div
                  class="banner-img banner-big wow fadeIn f-none animated mt-50"
                >
                  <img
                    class="border-radius-10"
                    src="/user-assets/imgs/banner/banner-4.png"
                    alt=""
                  />
                  <div class="banner-text">
                    <h4 class="mb-15 mt-40">Repair Services</h4>
                    <h2 class="fw-600 mb-20">
                      We're an Apple <br />Authorised Service Provider
                    </h2>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

 <script>
  // Function to show modal with a message
  function showModal(message) {
    const modal = document.getElementById('errorModal');
    const errorMessage = document.getElementById('errorMessage');
    errorMessage.innerText = message;
    modal.style.display = 'block';

    // Close the modal when the close button is clicked
    document.querySelector('#errorModal .close').onclick = function () {
      modal.style.display = 'none';
    };

    // Close the modal when clicking anywhere outside of the modal content
    window.onclick = function (event) {
      if (event.target == modal) {
        modal.style.display = 'none';
      }
    };

    // Auto-close the modal after 3 seconds
    setTimeout(() => {
      modal.style.display = 'none';
    }, 3000);
  }

  // Function to handle form submission
  document.getElementById('add-to-cart-form').addEventListener('submit', function(event) {
    event.preventDefault(); // Prevent the default form submission

    const form = event.target;
    const formData = new FormData(form);

    // Convert FormData to JSON
    const data = {};
    formData.forEach((value, key) => {
      data[key] = value;
    });

    // Get selected size
    const selectedSize = document.getElementById('selected-size').value;

    if (!selectedSize || !data.quantity) {
      showModal('Quantity and size are required.');
      return;
    }

    // Send AJAX request
    fetch('/product/addto-cart', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(data),
    })
    .then(response => {
      if(response.status === 401){
        const data = response.json();
        if(data.redirectTo){
          window.location.href = data.redirectTo;
        }
      }
        else if(response.redirected){
          window.location.href= response.url

        }
        else{
          return response.json()
        }
      
    })
    .then(data => {
      if (data.success) {
        showModal('Item added to cart!');
        // Optionally redirect to cart
        // window.location.href = '/cart';
      } else {
        showModal(data.message || 'Failed to add item to cart.');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      showModal('An error occurred while adding the item to the cart.');
    });
  });

  // Function to handle size selection
  document.querySelectorAll('#size-list li').forEach(function(sizeItem) {
    sizeItem.addEventListener('click', function() {
      document.getElementById('selected-size').value = this.dataset.size;
    });
  });
</script>

