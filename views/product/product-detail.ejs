                                        <option value="">All Categories</option>
                                        <% categories.forEach(cat => { %>
                                            <option value="<%= cat.name %>" <%= category === cat.name ? 'selected' : '' %>><%= cat.name %></option>
                                        <% }) %>
                                    </select>
                                </div>
