    <style>
        /* Style for the shop button */
.shop-button {
    display: inline-block;
    background-color: black; /* Background color */
    color: white; /* Text color */
    padding: 10px 20px; /* Padding to make the button larger */
    border-radius: 50px; /* Oval shape (border radius) */
    text-align: center; /* Center the text */
    text-decoration: none; /* Remove underline */
    font-size: 16px; /* Font size */
    font-weight: bold; /* Font weight */
    transition: background-color 0.3s ease, color 0.3s ease; /* Smooth transition for hover effects */
}

.shop-button:hover {
    background-color: #333; /* Slightly lighter black for hover effect */
    color: #fff; /* Ensure text remains white on hover */
}


.banner-img img {
    height: 300px;
    object-fit: cover; /* Ensures the image covers the container while maintaining its aspect ratio */
    width: 100%; /* Makes sure the image spans the width of the container */
}

.product-badges .hot {
    background-color: red;
    color: white;
}

.product-badges .new {
    background-color: green;
    color: white;
}

.product-badges .sale {
    background-color: orange;
    color: white;
}

.gender-section .gender-banner {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    height: 100%;
}

.gender-section .gender-banner img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    transition: transform 0.3s ease;
}

.gender-section .gender-banner:hover img {
    transform: scale(1.05);
}

.gender-section .gender-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    text-align: center;
    text-shadow: 0px 0px 5px rgba(0,0,0,0.5);
}

.gender-section .gender-text h2 {
    font-size: 28px;
    margin-bottom: 20px;
    color: white; /* White color for the headings */
}

.gender-section .gender-text a {
    color: white;
    background-color: black; /* Black background color for the button */
    padding: 10px 25px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
    display: inline-block;
}

.gender-section .gender-text a:hover {
    background-color: #333; /* Darker shade of black for hover */
    color: white; /* Keep the text white on hover */
}

        .banners .banner-img {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
}

.banners .banner-img img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    transition: transform 0.3s ease;
}

.banners .banner-img:hover img {
    transform: scale(1.05);
}

.banners .banner-text {
    position: absolute;
    bottom: 15%;
    left: 10%;
    color: white;
    z-index: 10;
    text-shadow: 0px 0px 5px rgba(0,0,0,0.5);
}

.banners .banner-text h4 {
    font-size: 24px;
    margin: 10px 0;
}

.banners .banner-text a {
    color: white;
    background-color: #ff6f61;
    padding: 8px 20px;
    border-radius: 5px;
    text-decoration: none;
}

.banners .discount-badge {
    top: 10px;
    right: 10px;
    background-color: #ff6f61;
    color: white;
    padding: 8px 15px;
    border-radius: 50%;
    font-size: 16px;
    font-weight: bold;
}

.banners .discount-badge span {
    display: block;
}


    </style>

</head>

