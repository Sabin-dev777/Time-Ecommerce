          <script>
            async function addToWishlist(productId) {
              try {
                const response = await fetch('/wishlist/add', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json'
                  },
                  body: JSON.stringify({ productId })
                });
          
                const result = await response.json();
                
                // Check if the product was added successfully or not
                if (result.success) {
                  showModal('Success', 'Product added to wishlist');
                } else {
                  showModal('Error', result.message || 'Failed to add to wishlist');
                }
              } catch (error) {
                console.error('Error adding to wishlist:', error);
                showModal('Error', 'An error occurred while adding to wishlist');
              }
            }
          
            // Function to show modal with dynamic title and message
            function showModal(title, message) {
              // Set the modal title and message content
              document.getElementById('modalTitle').innerText = title;
              document.getElementById('modalMessage').innerText = message;
          
              // Show the modal
              $('#messageModal').modal('show');
            }
          
            // Function to close the modal
            function closeModal() {
              $('#messageModal').modal('hide');
            }
          </script>
     
          
          
          
       
        
      
     
