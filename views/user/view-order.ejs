    <script>
   async function cancelOrder(orderId) {
    console.log('Cancel Order ID:', orderId);

    const isConfirmed = confirm('Are you sure you want to cancel this order?');

    if (isConfirmed) {
        try {
            const response = await fetch('/cancel-order', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ orderId }),
            });

            const data = await response.json();

            if (data.success) {
                alert('Order cancelled successfully.');

                // Update UI elements to show cancelled status
                const statusElement = document.querySelector('.order-status');
                if (statusElement) {
                    statusElement.innerHTML = '<span class="badge rounded-pill alert-danger text-danger">Cancelled</span>';
                }

                // Reload the page to reflect updated status
                location.reload();
            } else {
                alert(data.message || 'An error occurred while cancelling the order.');
            }
        } catch (error) {
            console.error('Error during order cancellation:', error);
            alert('An error occurred during order cancellation. Please try again.');
        }
    }
}


       
