      <section class="mt-50 mb-50">
        <div class="container pdf">
            <div class="col-lg-12">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th width="40%">Product</th>
                                <th width="20%">Unit Price</th>
                                <th width="20%">Quantity</th>
                                <th width="20%" class="text-end">Original Total</th>
                            </tr>
                        </thead>
                        <tbody>
                          <% 
                          let originalTotal = 0; 
                          let discountedTotal = 0; 
                          let productDiscount = 0; 
                          const couponDiscount = orders.couponDiscount || 0; 
                      
                          orders.cartItems.forEach(cartItem => {
                              cartItem.items.forEach(item => {
                                  const quantity = item.quantity;
                                  const price = item.product.price;
                                  const discountedPrice = item.product.discountedPrice || price;
                      
                                  originalTotal += price * quantity;
                                  discountedTotal += discountedPrice * quantity;
                                  productDiscount += (price - discountedPrice) * quantity;
                          %>
                          <tr>
                              <td>
                                  <div class="itemside">
                                      <div class="left">
                                          <img 
                                              src="<%= (item.product.images && item.product.images.length > 0) ? '/uploads/' + item.product.images[item.product.images.length - 1] : '/path/to/default-image.jpg' %>" 
                                              width="100" 
                                              height="100" 
                                              class="img-xs" 
                                              alt="<%= item.product.name %>">
                                      </div>
                                      <div class="info">
                                          <%= item.product.name %>
                                      </div>
                                  </div>
                              </td>
                              <td>
                                  ₹<% if (item.product.discountedPrice) { %>
                                      <span class="text-muted"><del><%= price %></del></span>
                                      <span>₹<%= discountedPrice %></span>
                                  <% } else { %>
                                      ₹<%= price %>
                                  <% } %>
                              </td>
                              <td><%= quantity %></td>
                              <td class="text-end">
                                  ₹<%= (discountedPrice * quantity).toFixed(2) %>
                              </td>
                          </tr>
                          <% 
                              });
                          });
                      
                          const totalDiscount = productDiscount + couponDiscount;
                          %>
                      
                          <tr>
                              <td colspan="4">
                                  <div class="card text-dark bg-light mb-3">
                                      <div class="card-header">Order Summary</div>
                                      <div class="card-body">
                                          <dl class="row">
                                              <dt class="col-sm-6">Original Total:</dt>
                                              <dd class="col-sm-6">₹<%= originalTotal.toFixed(2) %></dd>
                      
                                              <dt class="col-sm-6">Product Discounts:</dt>
                                              <dd class="col-sm-6">- ₹<%= productDiscount.toFixed(2) %></dd>
                                              <dt class="col-sm-6">Coupon Discounts:</dt>
                                              <dd class="col-sm-6">- ₹<%= couponDiscount.toFixed(2) %></dd>
                      
                                              <dt class="col-sm-6">Total Discount:</dt>
                                              <dd class="col-sm-6">- ₹<%= totalDiscount.toFixed(2) %></dd>
                      
                                              <dt class="col-sm-6">Subtotal (with discounts):</dt>
                                              <dd class="col-sm-6">₹<%= orders.totalprice.toFixed(2) %></dd>
                      
                                              <dt class="col-sm-6">Grand total:</dt>
                                              <dd class="col-sm-6"><b class="h5">₹<%= orders.totalprice.toFixed(2) %></b></dd>
                      
                                              <dt class="col-sm-6 text-muted">Status:</dt>
                                              <dd class="col-sm-6">
                                                  <span class="badge rounded-pill alert-success text-success"><%= orders.orderStatus %></span>
                                              </dd>
                      
                                              <dt class="col-sm-6">Mode of payment:</dt>
                                              <dd class="col-sm-6"><%= orders.paymentOption %></dd>
                      
                                              <dt class="col-sm-6">Shipping Address:</dt>
                                              <dd class="col-sm-6">
                                                  <address>
                                                      <% if (shippingAddress) { %>
                                                          <%= shippingAddress.house %>, <%= shippingAddress.street %><br>
                                                          <%= shippingAddress.landmark %><br>
                                                          <%= shippingAddress.city %>, <%= shippingAddress.state %> - <%= shippingAddress.zip %><br>
                                                          <%= shippingAddress.country %>
                                                      <% } else { %>
                                                          <p>No shipping address available.</p>
                                                      <% } %>
                                                  </address>
                                              </dd>
                                          </dl>
                                      </div>
                      
                                      <% if (orders.orderStatus !== 'cancelled' && orders.orderStatus !== 'delivered' && orders.orderStatus !== 'returned') { %>
                                          <button onclick="cancelOrder('<%= orders._id %>')" class="btn btn-danger">Cancel Order</button>
                                      <% } else if (orders.orderStatus === 'cancelled') { %>
                                          <p class="text-danger">Order Cancelled</p>
                                      <% } %>
                                  </div>
                                  <button onclick="downloadInvoice()" class="btn btn-primary">Download Invoice</button>
                      
                                  <% if (orders.orderStatus === 'delivered') { %>
                                      <% if (!orders.returnRequest || orders.returnRequest.status !== 'requested' && orders.returnRequest.status !== 'approved' && orders.returnRequest.status !== 'declined') { %>
                                          <button onclick="requestReturn('<%= orders._id %>')" class="btn btn-warning">Request Return</button>
                                      <% } else if (orders.returnRequest.status === 'requested') { %>
                                          <p class="text-warning">Return request pending</p>
                                      <% } else if (orders.returnRequest.status === 'approved') { %>
                                          <p class="text-success">Return approved</p>
                                      <% } else if (orders.returnRequest.status === 'declined') { %>
                                          <p class="text-danger">Return declined</p>
                                      <% } %>
                                  <% } %>
                              </td>
                          </tr>
                      </tbody>
                      
