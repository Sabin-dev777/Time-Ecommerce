  <script>
    function requestReturn(orderId) {
      fetch(`/orders/${orderId}/request-return`, {
          method: 'POST',
          headers: {
              'Content-Type': 'application/json',
              // Authorization header removed
          },
          credentials: 'same-origin', // This ensures cookies (if used for authentication) are sent with the request
      })
      .then(response => response.json())
      .then(data => {
          const responseMessageElement = document.getElementById('responseMessage');
          if (data.success) {
              // Set the success message in the modal
              responseMessageElement.textContent = 'Return request successfully created';
          } else {
              // Set the error message in the modal
              responseMessageElement.textContent = data.message || 'An error occurred';
          }
  
          // Show the modal
          const modal = new bootstrap.Modal(document.getElementById('responseModal'));
          modal.show();
  
          // Attach an event listener to reload the page when the modal is hidden
          const modalElement = document.getElementById('responseModal');
          modalElement.addEventListener('hidden.bs.modal', () => {
              location.reload();
          }, { once: true }); // The { once: true } ensures the listener is called only once
      })
      .catch(error => {
          console.error('Error:', error);
          const responseMessageElement = document.getElementById('responseMessage');
          responseMessageElement.textContent = 'An error occurred. Please try again.';
          
          // Show the modal
          const modal = new bootstrap.Modal(document.getElementById('responseModal'));
          modal.show();
  
          // Attach an event listener to reload the page when the modal is hidden
          const modalElement = document.getElementById('responseModal');
          modalElement.addEventListener('hidden.bs.modal', () => {
              location.reload();
          }, { once: true });
      });
    }
  </script>
  
    
