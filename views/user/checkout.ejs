<script>
    function updateTotalWithWallet() {
        const useWalletCheckbox = document.getElementById('useWallet');
        const totalAmountElem = document.getElementById('totalAmount');
        const walletAmountElem = document.getElementById('walletAmount');
        const walletAppliedAmount = document.getElementById('walletAppliedAmount');
        const walletBalance = <%= user.walletBalance %>;
        const subtotal = parseFloat(document.querySelector("input[name='totalprice']").value);

        let updatedTotal = subtotal;

        if (useWalletCheckbox.checked) {
            const walletUsed = Math.min(walletBalance, subtotal);
            updatedTotal -= walletUsed;
            walletAmountElem.textContent = walletUsed;
            document.getElementById('walletUsedAmount').value = walletUsed;
            walletAppliedAmount.style.display = 'block';
        } else {
            document.getElementById('walletUsedAmount').value = 0;
            walletAppliedAmount.style.display = 'none';
        }

        totalAmountElem.textContent = `${updatedTotal.toFixed(2)}`;
        
        // Hide other payment options if the total is zero
        const paymentOptions = document.getElementById('paymentOptions');
        if (updatedTotal === 0) {
            paymentOptions.style.display = 'none';
            document.getElementById('cashOnDeliveryOption').checked = true;
        } else {
            paymentOptions.style.display = 'block';
        }
    }

    function submitForm() {
        document.getElementById('placeOrderForm').submit();
    }
</script>

             
<script>
    const modal = document.getElementById('couponModal');
const btn = document.getElementById('openCouponModal');
const span = document.getElementsByClassName('close')[0];

// Open the modal
btn.onclick = function() {
  modal.style.display = 'block';
}

// Close the modal
span.onclick = function() {
  modal.style.display = 'none';
}

// Close the modal when user clicks outside the modal
window.onclick = function(event) {
  if (event.target == modal) {
    modal.style.display = 'none';
  }
}

async function applyCoupon() {
  const couponCode = document.getElementById('couponCode').value;
  const cartId = "<%= cartId %>"; // Get cartId from your server-side rendering
  const url = `/apply-coupon/${cartId}?couponCode=${couponCode}`;

  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
      },
    });

    if (response.ok) {
      const data = await response.json();
      console.log(data);
      // Refresh the page to see the changes
      location.reload();
    } else {
      const errorData = await response.json();
      alert(errorData.error);
    }
  } catch (error) {
    console.error('Error applying coupon:', error);
    alert('An error occurred while applying the coupon. Please try again.');
  }
}

async function removeCoupon(event) {
  event.preventDefault();
  const cartId = "<%= cartId %>"; // Get cartId from your server-side rendering
  const url = `/remove-coupon/${cartId}`;

  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
      },
    });

    if (response.ok) {
      const data = await response.json();
      console.log(data);
      // Refresh the page to see the changes
      location.reload();
    } else {
      const errorData = await response.json();
      alert(errorData.error);
    }
  } catch (error) {
    console.error('Error removing coupon:', error);
    alert('An error occurred while removing the coupon. Please try again.');
  }
}


