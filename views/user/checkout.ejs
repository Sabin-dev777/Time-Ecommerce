      <script>
        function submitForm() {
            var selectedAddress = document.querySelector('input[name="selectedAddress"]:checked');
            var selectedPayment = document.querySelector('input[name="paymentOption"]:checked');
        
            if (selectedAddress && selectedPayment) {
                document.getElementById('selectedAddressHidden').value = selectedAddress.value;
                document.getElementById('selectedPayment').value = selectedPayment.value;
                document.getElementById('placeOrderForm').submit();
            } else {
