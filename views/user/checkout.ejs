        <section class="mt-50 mb-50">
            <div class="container">
                <div class="row">
                    <!--  -->
                   
                </div>
              
                <style>
                    /* Add custom styles for radio buttons */
                    .form-check-label {
                        display: flex;
                        align-items: center;
                    }
                
                    .form-check-input {
                        margin-right: 5px; /* Adjust the margin as needed */
                    }
                </style>
                <form id="placeOrderForm" action="/place-order/<%= cartId %>" method="post">
                    <div class="row">
                        <!-- Order Details -->
                        <div class="col-md-6">
                            <div class="order_review">
                                <div class="mb-20">
                                    <h4>Your Orders</h4>
                                </div>
                                <div class="table-responsive order_table text-center">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Product</th>
                                                <th>Size</th> <!-- New column for Size -->
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% let subtotal = 0; %>
                                            <% if (products.length > 0) { %>
                                                <% for (let i = 0; i < products.length; i++) { %>
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center" style="justify-content: center;">
                                                                <img src="<%= '/uploads/' + products[i].product.images[products[i].product.images.length - 1] %>" alt="" style="width: 100px; height: 100px" />
                                                                <div style="margin-left: 15px;">
                                                                    <h5><%= products[i].product.name %></h5>
                                                                    <span class="product-qty">x<%= products[i].quantity %></span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td><%= products[i].size %></td> <!-- Display the size -->
                                                        <%if(products[i].product.discountedPrice){%>
                                                            <td>&#8377;<%= products[i].product.discountedPrice * products[i].quantity %></td>
                                                            <% subtotal += products[i].product.discountedPrice * products[i].quantity %>


                                                        <%}else{%>
                                                            <td>&#8377;<%= products[i].product.price * products[i].quantity %></td>
                                                            <% subtotal += products[i].product.price * products[i].quantity %>

                                                        <%}%>
                                                       
                                                    </tr>
                                                <% } %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="3">No products in the cart.</td>
                                                </tr>
                                            <% } %>
                                            <tr>
                                                <th>SubTotal</th>
                                                <td class="product-subtotal" colspan="2">&#8377;<%= subtotal %></td>
                                            </tr>
                                            <% if (appliedCoupon) { %>
                                                <tr>
                                                    <th>Coupon Applied: <%= appliedCoupon.couponCode %> <a href="#" class="remove-coupon" onclick="removeCoupon(event)">Remove Coupon</a></th>
                                                    <td colspan="2">-&#8377;<%= subtotal - newSubtotal %></td>
                                                </tr>
                                                <tr>
                                                    <th>New Subtotal</th>
                                                    <td class="product-subtotal" colspan="2">&#8377;<%= newSubtotal %></td>
                                                </tr>
                                            <% } %>
                                            <tr>
                                                <th>Shipping</th>
                                                <td colspan="2"><em>Free Shipping</em></td>
                                            </tr>
                                            <tr>
                                                <th>Total</th>
                                                <td class="product-subtotal" colspan="2">
                                                    <span id="totalAmount" class="font-xl text-brand fw-900">&#8377;<%= newSubtotal || cart.total %></span>
                                                    <input type="hidden" name="totalprice" value="<%= newSubtotal || cart.total %>">
                                                    <input type="hidden" name="cartId" value="<%= cartId %>">
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    
                                </div>
                                <button id="openCouponModal" class="btn btn-md" type="button">Apply Coupon</button>
                                
                                <!-- The Modal -->
                                <div id="couponModal" class="modal">
                                    <div class="modal-content">
                                        <span class="close">&times;</span>
                                        <h2 style="text-align: center;">Apply Coupon</h2>
                                        <form id="applyCouponForm">
                                            <div class="form-group">
                                                <label for="couponCode">Select Coupon:</label>
                                                <select name="couponCode" id="couponCode">
                                                    <% coupons.forEach(coupon => { %>
                                                        <option value="<%= coupon.couponCode %>"><%= coupon.couponCode %></option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <button class="btn btn-md" type="button" onclick="applyCoupon()">Apply Coupon</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                
                                <div class="payment_method">
                                    <div class="mb-25">
                                        <h5 style="padding-top: 32px;">Payment</h5>
                                    </div>
                                    <% if (user.walletBalance > 0) { %>
                                        <div class="wallet-option" style="margin-top: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 8px; background-color: #f9f9f9;">
                                            <label style="font-size: 16px; font-weight: 600; display: flex; align-items: center;">
                                                <!-- Checkbox for Wallet Balance -->
                                                <input type="checkbox" id="useWallet" onchange="updateTotalWithWallet()" style="margin-right: 10px;"/>
                                                <span>Use Wallet Balance (Available: <span style="color: #28a745;">&#8377;<%= user.walletBalance %></span>)</span>
                                            </label>
                                            <!-- Wallet Applied Amount Section -->
                                            <p id="walletAppliedAmount" style="display: none; font-size: 14px; color: #555; margin-top: 10px;">
                                                Wallet Applied: <span id="walletAmount" style="font-weight: bold;">0</span>
                                            </p>
                                            <input type="hidden" name="walletUsedAmount" id="walletUsedAmount" value="0" />
                                        </div>
                                    <% } %>
                                    
                                     
                                    <div class="payment_option" id="paymentOptions">
                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5 class="mb-0">Payment Options</h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="form-check mb-3">
