    <main class="main">
        <div class="page-header breadcrumb-wrap">
            <div class="container">
                <div class="breadcrumb">
                    <a href="index.html" rel="nofollow">Home</a>
                    <span></span> Shop
                    <span></span> Wishlist
                </div>
            </div>
        </div>
        <section class="mt-50 mb-50">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead style="color: white; background-color: black;">
                                  <tr>
                                    <th>Name</th>
                                    <th>Image</th>
                                    <th>Price</th>
                                    <th class="text-end">Action</th>
                                  </tr>
                                </thead>
                                <tbody>
                                    <% if (wishlistItems.length > 0) { %>
                                      <% wishlistItems.forEach(item => { %>
                                        <tr id="row_<%= item._id %>">
                                            <td><%= item.name %></td>
                                            <td>
                                              <img 
                                                src="<%= (item.images && item.images.length > 0) ? '/uploads/' + item.images[item.images.length - 1] : '/path/to/default-image.jpg' %>" 
                                                alt="Product Image" 
                                                style="width: 100px; height: 100px" 
                                              />
                                            </td>
                                            <td>
                                                <% if (item.discountedPrice && item.discountedPrice < item.price) { %>
                                                  <span>&#8377;<%= item.discountedPrice %></span>
                                                  <del class="text-muted">&#8377;<%= item.price %></del>
                                                <% } else { %>
                                                  <span>&#8377;<%= item.price %></span>
                                                <% } %>
                                              </td>
                                            <td class="text-end">
                                              <button 
                                                class="btn btn-sm btn-primary" 
                                                onclick="addToCartFromWishlist('<%= item._id %>')">
                                                Add to Cart
                                              </button>
                                              <button 
                                                class="btn btn-sm btn-danger" 
                                                onclick="removeFromWishlist('<%= item._id %>')">
                                                Remove
                                              </button>
                                            </td>
                                          </tr>
                                          
                                      <% }); %>
                                    <% } else { %>
                                      <tr>
                                        <td colspan="4">Your wishlist is empty.</td>
                                      </tr>
                                    <% } %>
                                  </tbody>
                                  
                              </table>
                              
                              
                          </div>
                          
                      
                    </div>
                </div>
            </div>
        </section>
