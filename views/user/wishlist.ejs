    <script>
   let selectedProductId; // Store the selected product ID
let availableSizes = []; // Store available sizes for the selected product

// Show the modal when "Add to Cart" button is clicked
function addToCartFromWishlist(productId) {
  selectedProductId = productId;

  // Fetch product details to get available sizes
  fetch(`/product/details/${productId}`)
    .then((response) => {
      if (!response.ok) {
        throw new Error(`Network response was not ok: ${response.statusText}`);
      }
      return response.json();
    })
    .then((product) => {
      if (product && product.sizes) {
        availableSizes = product.sizes;

        // Populate size options in the modal
        const sizeSelect = document.getElementById('sizeSelect');
        sizeSelect.innerHTML = ''; // Clear previous options
        availableSizes.forEach((sizeOption) => {
          if (sizeOption.quantity > 0) {
            const option = document.createElement('option');
            option.value = sizeOption.size;
            option.text = sizeOption.size;
            sizeSelect.appendChild(option);
          }
        });

        // Display the modal
        document.getElementById('product-id').value = productId;
        $('#sizeQuantityModal').modal('show');
      } else {
        alert('No available sizes for this product.');
      }
    })
    .catch((error) => {
      console.error('Error fetching product details:', error);
      alert('Could not fetch product details.');
    });
}

// Submit the form to add the product to the cart
function submitAddToCart() {
  const sizeSelect = document.getElementById('sizeSelect');
  const quantityInput = document.getElementById('quantityInput');

  const selectedSize = sizeSelect.value;
  const selectedQuantity = parseInt(quantityInput.value, 10);

  if (!selectedSize || selectedQuantity < 1) {
    alert('Please select a size and enter a valid quantity.');
    return;
  }

  // Send the request to add the item to the cart
  fetch('/cart/add-from-wishlist', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      productId: selectedProductId,
      size: selectedSize,
      quantity: selectedQuantity,
    }),
  })
    .then((response) => response.json())
    .then((result) => {
      if (result.success) {
        alert('Product added to cart!');
        $('#sizeQuantityModal').modal('hide');
        // Optionally, remove the product from the wishlist dynamically
        const productRow = document.getElementById(`row_${selectedProductId}`);
        if (productRow) productRow.remove();
        window.location.reload()
      } else {
        alert(result.message || 'Failed to add product to cart.');
      }
    })
    .catch((error) => {
      console.error('Error adding product to cart:', error);
      alert('An error occurred while adding the product to the cart.');
    });
}

function closeModal() {
  $('#sizeQuantityModal').modal('hide');
}


function removeFromWishlist(productId) {
  fetch('/wishlist/remove', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ productId }),
  })
    .then((response) => response.json())
    .then((data) => {
      if (data.success) {
        alert('Product removed from wishlist');
        const productRow = document.getElementById(`row_${productId}`);
        if (productRow) {
          productRow.remove();
          window.location.reload() // Dynamically remove the row from the table
        }
        
      } else {
        alert(data.message || 'Failed to remove product from wishlist');
      }
    })
    .catch((error) => {
      console.error('Error removing product from wishlist:', error);
      alert('An error occurred while removing the product');
    });
}

        
        </script>
        
