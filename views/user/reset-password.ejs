<!DOCTYPE HTML>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Reset Password</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="/admin-assets/imgs/theme/favicon.svg">
    <!-- Template CSS -->
    <link href="/admin-assets/css/main.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <main>
        <section class="content-main mt-80 mb-80" style="background-image: url('/Images/warranty-login-page.avif'); background-size: cover; min-height: 100vh;">
            <div class="card mx-auto card-login">
                <div class="card-body">
                    <h4 class="card-title mb-4">Reset Password</h4>
                    <form action="/forget-password" method="post">
                        <input type="hidden" name="userid" value="<%= userid %>">

                        <div class="mb-3">
                            <input class="form-control" name="password" placeholder="New Password" type="password" required>
                        </div>
                        <div class="mb-3">
                            <input class="form-control" name="confirmPassword" placeholder="Confirm Password" type="password" required>
                        </div>

                        <% if (typeof message !== 'undefined' && message) { %>
                            <h3 style="color: red; font-family: Arial, sans-serif; font-size: small;"><%= message %></h3>
                        <% } %>

                        <div class="mb-4">
                            <button type="submit" class="btn btn-primary w-100">Reset Password</button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </main>
    <script src="/admin-assets/js/vendors/jquery-3.6.0.min.js"></script>
    <script src="/admin-assets/js/vendors/bootstrap.bundle.min.js"></script>
    <script src="/admin-assets/js/main.js" type="text/javascript"></script>
</body>
</html>
