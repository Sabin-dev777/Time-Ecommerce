    <main class="main">
      <div class="page-header breadcrumb-wrap">
        <div class="container">
          <div class="breadcrumb">
            <a href="index.html" rel="nofollow">Home</a>
            <span></span> Shop <span></span> Your Cart
          </div>
        </div>
      </div>
      <section class="mt-50 mb-50">
        <div class="container">
            <div id="cart-container" class="row">
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead style="color: white; background-color: black;">
                                <tr>
                                    <th>Name</th>
                                    <th>Image</th>
                                    <th>Size</th> <!-- New Size Column -->
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Total</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                              <% let subtotal = 0; %>
                              <% if (products.length > 0) { %>
                                  <% for (let i = 0; i < products.length; i++) { %>
                                      <tr id="row_<%= products[i].product._id %>">
                                          <td><%= products[i].product.name %></td>
                                          <td>
                                              <img 
                                                  src="<%= '/uploads/' + products[i].product.images[products[i].product.images.length - 1] %>" 
                                                  alt="" 
                                                  style="width: 100px; height: 100px" 
                                              />
                                          </td>
                                          <td><%= products[i].size %></td> <!-- Display Size -->
                                          <td>
                                              <span id="quantity_<%= products[i].product._id %>_<%= products[i].size %>"><%= products[i].quantity %></span>
                                              <button onclick="updateQuantity('<%= products[i].product._id %>', 'increase', '<%= products[i].size %>')">
                                                  <i class="fa fa-plus">+</i>
                                              </button>
                                              <button 
                                                  class="decrease-quantity-button" 
                                                  onclick="updateQuantity('<%= products[i].product._id %>', 'decrease', '<%= products[i].size %>')"
                                              >
                                                  -
                                              </button>
                                          </td>
                                          <% if (products[i].product.discountedPrice) { %>
                                              <td>&#8377;<%= products[i].product.discountedPrice %></td>
                                              <td id="total_<%= products[i].product._id %>">
                                                  &#8377;<%= products[i].product.discountedPrice * products[i].quantity %>
                                              </td>
                                              <td class="text-end">
                                                  <div onclick="showDeleteConfirmation('<%= products[i].product._id %>', '<%= products.length %>')">
                                                      Delete
                                                  </div>
                                              </td>
                                              <% subtotal += products[i].product.discountedPrice * products[i].quantity; %>
                                          <% } else { %>
                                              <td>&#8377;<%= products[i].product.price %></td>
                                              <td id="total_<%= products[i].product._id %>">
                                                  &#8377;<%= products[i].product.price * products[i].quantity %>
                                              </td>
                                              <td class="text-end">
                                                  <div onclick="showDeleteConfirmation('<%= products[i].product._id %>', '<%= products.length %>')">
                                                      Delete
                                                  </div>
                                              </td>
                                              <% subtotal += products[i].product.price * products[i].quantity; %>
                                          <% } %>
                                      </tr>
                                  <% } %>
                              <% } else { %>
                                  <tr>
                                      <td colspan="7">No products in the cart.</td>
                                  </tr>
                              <% } %>
                              <tr id="noItemsIncart" class="d-none">
                                  <td colspan="7">No products in the cart.</td>
                              </tr>
                          </tbody>
                          
                        </table>
                    </div>
                    
                    <!-- Bootstrap Modal Structure for Error Messages -->
                    <div class="modal fade" id="quantityLimitModal" tabindex="-1" aria-labelledby="quantityLimitModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-sm">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="quantityLimitModalLabel">Quantity Limit Reached</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body" id="quantityLimitModalBody">
                                    <!-- Message will be inserted here via JavaScript -->
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <div class="cart-action text-end">
                        <a class="btn mr-10 mb-sm-15" onclick="window.location.href='/checkout'">
                            <i class="fi-rs-shopping-bag mr-10"></i>Buy Now
                        </a>
                        <a class="btn" onclick="window.location.href='/product'">
                            <i class="fi-rs-shopping-bag mr-10"></i>Continue Shopping
                        </a>
                    </div>
                    <div class="divider center_icon mt-50 mb-50">
                        <i class="fi-rs-fingerprint"></i>
                    </div>
                    <div class="row mb-50">
                        <div class="col-lg-6 col-md-12">
                            
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <div class="border p-md-4 p-30 border-radius cart-totals">
                                <div class="heading_s1 mb-3">
                                    <h4>Cart Totals</h4>
                                </div>
                                <div class="table-responsive">
                                    <table class="table">
                                        <tbody>
                                            <tr>
                                                <td class="cart_total_label">Cart Subtotal</td>
                                                <td class="cart_total_amount">
                                                    <span id="subtotal" class="font-lg fw-900 text-brand">&#8377;<%=subtotal%></span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="cart_total_label">Shipping</td>
                                                <td class="cart_total_amount">
                                                    <i class="ti-gift mr-5"></i> Free Shipping
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="cart_total_label">Total</td>
                                                <td class="cart_total_amount">
                                                    <strong>
                                                        <span id="cart-total" class="font-xl fw-900 text-brand">&#8377;<%=subtotal%></span>
                                                    </strong>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <a href="/checkout" class="btn">
                                    <i class="fi-rs-box-alt mr-10"></i> Proceed To CheckOut
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
     
    <!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
          <div class="modal-header">
              <h5 class="modal-title" id="deleteConfirmationModalLabel">Confirm Deletion</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
              Are you sure you want to delete this item?
          </div>
          <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="button" class="btn btn-danger" id="confirmDeleteButton">Delete</button>
          </div>
      </div>
  </div>
</div>
      
      <!-- Success Message Modal -->
      <div class="modal fade" id="deletedMessageModal" tabindex="-1" aria-labelledby="deletedMessageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deletedMessageModalLabel">Item Deleted</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    The item has been successfully deleted from your cart.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
      </div>
<script>

let productIdToDelete;

// Function to set the productIdToDelete and show delete confirmation modal
function showDeleteConfirmation(productId,productLength) {
    productIdToDelete = productId;
    console.log('Product ID to delete:', productId);

    // Show the delete confirmation modal
    $('#deleteConfirmationModal').modal('show');
    
    // Ensure the 'click' event listener is only added once
    const confirmButton = document.getElementById('confirmDeleteButton');
    confirmButton.removeEventListener('click', deleteItemAndShowMessage);
    confirmButton.addEventListener('click',(event)=>{
      event.preventDefault();
      deleteItemAndShowMessage(productLength);
    });
}

// Function to delete the item and show the deleted message modal
async function deleteItemAndShowMessage(productLength) {
    console.log('Deleting product ID:', productIdToDelete,productLength);

    try {
        const response = await fetch(`/delete-product?id=${productIdToDelete}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        if (response.ok) {
            // Close the delete confirmation modal
            $('#deleteConfirmationModal').modal('hide');
            

            document.getElementById(`row_`+productIdToDelete).remove();
            if(productLength == 1){
              document.getElementById("noItemsIncart").classList.remove("d-none")
              document.getElementById("noItemsIncart").classList.add("d-table-row")
              
              
            }
            updateSubtotal();

            // Reload or update cart content
            // await reloadCart();

            // Show the deleted message modal
            $('#deletedMessageModal').modal('show');
         
        } else {
            console.error('Failed to delete item:', response.statusText);
        }
    } catch (error) {
        console.error('Error:', error);
    }
}

// Function to reload or update cart content
async function reloadCart() {
    console.log('Reloading cart...');
      
    try {
        const response = await fetch('/cart', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json'
            },
        });

        if (response.ok) {
          console.log(response,"response")
            

                updateSubtotal();
                window.location.reload();
          
        } else {
            console.error('Failed to reload cart:', response.statusText);
        }
    } catch (error) {
        console.error('Error:', error);
    }
}
function updateQuantity(productId, action,size) {
    fetch(`/update-quantity?id=${productId}&action=${action}&size=${size}`, {
        method: 'GET',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.error) {
            showModal(data.error);
        } else {
            const quantityElement = document.getElementById(`quantity_${productId}_${size}`);
            const totalElement = document.getElementById(`total_${productId}`);
            const decreaseButton = document.querySelector(`#row_${productId} .decrease-quantity-button`);

            if (data.quantity > 0) {
                // Update the quantity and total on the UI
                quantityElement.textContent = data.quantity;
                totalElement.textContent = `₹${data.productTotal.toFixed(2)}`;

                // Show or hide the decrease button based on the quantity
                decreaseButton.style.display = data.quantity >= 1 ? 'inline-block' : 'none';
            } else {
                // If quantity is reduced to 0, remove the row from the UI
                document.getElementById(`row_${productId}`).remove();
            }

            updateSubtotal();  // Ensure the subtotal is recalculated
        }
    })
    .catch(error => console.error('Error:', error));
}


// Function to update subtotal
function updateSubtotal() {
    let subtotal = 0;
    document.querySelectorAll('[id^="total_"]').forEach(item => {
        const total = parseFloat(item.textContent.replace('₹', ''));
        subtotal += total;
    });
    document.getElementById('subtotal').textContent = `₹${subtotal.toFixed(2)}`;
    document.getElementById('cart-total').textContent = `₹${subtotal.toFixed(2)}`;
}

// Function to display modal messages
function showModal(message) {
    document.getElementById('quantityLimitModalBody').textContent = message;
    const modal = new bootstrap.Modal(document.getElementById('quantityLimitModal'));
    modal.show();
}






</script>

